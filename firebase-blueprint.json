      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "email": { "type": "string", "minLength": 15, "maxLength": 120, "pattern": "^[a-zA-Z0-9._%+\\-]+@cs\\.udf\\.edu\\.br$" },
        "role": { "type": "string", "enum": ["ADMIN", "RECEPCAO", "TRIAGEM", "PROFESSOR", "ALUNO"] },
        "registrationCode": { "type": "string", "minLength": 1, "maxLength": 40 },
        "specialty": { "type": "string", "minLength": 1, "maxLength": 80 },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "minLength": 0, "maxLength": 40 },
        "lastAccess": { "type": "string", "minLength": 0, "maxLength": 40 },
        "mustChangePassword": { "type": "boolean" },
        "institutionDomain": { "type": "string", "enum": ["cs.udf.edu.br"] },
        "createdByUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" }
      },
      "required": ["uid", "name", "email", "role", "registrationCode", "specialty", "active", "institutionDomain", "createdByUid"]
