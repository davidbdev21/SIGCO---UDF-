          "type": "string",
          "enum": ["CONFIRMACAO", "LEMBRETE", "ALTERACAO_HORARIO", "CANCELAMENTO", "ENCAMINHAMENTO", "AVISO_TRIAGEM", "ALERTA_FALTAS"]
        },
        "channel": { "type": "string", "enum": ["SISTEMA", "WHATSAPP_FILA", "EMAIL"] },
        "message": { "type": "string", "minLength": 2, "maxLength": 1000 },
        "status": { "type": "string", "enum": ["PENDENTE", "ENVIADA", "LIDA"] },
        "date": { "type": "string", "minLength": 8, "maxLength": 30 },
        "institutionDomain": { "type": "string", "enum": ["cs.udf.edu.br"] },
        "createdByUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" }
      },
      "required": [
        "recipientName",
        "recipientContact",
        "type",
        "channel",
        "message",
        "status",
        "date",
        "institutionDomain",
        "createdByUid"
      ]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable LGPD-compliant security and clinical operation audit log.",
