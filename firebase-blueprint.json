        "userName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "userEmail": { "type": "string", "minLength": 5, "maxLength": 120 },
        "userRole": { "type": "string", "enum": ["ADMIN", "RECEPCAO", "TRIAGEM", "PROFESSOR", "ALUNO"] },
        "action": { "type": "string", "minLength": 2, "maxLength": 120 },
        "targetRecord": { "type": "string", "minLength": 1, "maxLength": 200 },
        "operationSummary": { "type": "string", "minLength": 2, "maxLength": 500 },
        "timestampIso": { "type": "string", "minLength": 8, "maxLength": 40 },
        "institutionDomain": { "type": "string", "enum": ["cs.udf.edu.br"] },
        "createdByUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" }
      },
      "required": [
        "userName",
        "userEmail",
        "userRole",
        "action",
        "targetRecord",
        "operationSummary",
        "timestampIso",
        "institutionDomain",
        "createdByUid"
      ]
    }
