        "institutionDomain": { "type": "string", "enum": ["cs.udf.edu.br"] },
        "createdByUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" }
      },
      "required": ["name", "email", "cro", "specialty", "clinicName", "active", "institutionDomain", "createdByUid"]
    },
    "NotificationItem": {
      "title": "NotificationItem",
      "description": "Patient and staff notification log prepared for WhatsApp/SMS dispatch.",
